# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard: Project Settings > API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" (publishable) key. Never put the service_role key here: Stillroom doesn't need it.
SUPABASE_ANON_KEY=your-anon-key

# Optional: the port the server listens on (default 8787).
# PORT=8787
